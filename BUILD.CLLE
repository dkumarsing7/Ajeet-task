/* ========================================================================= */
/* Program Name : BUILD                                                      */
/* Description  : Build & Compilation Script for RPG Extraction & Sizing     */
/* Language     : ILE CL (CLLE)                                              */
/* Author       : IBM i Extraction Utility Team                              */
/*                                                                           */
/* Compilation Sequence:                                                     */
/* 1. IASRCRECP (SQL DDL) - Consolidated Source Records Repository           */
/* 2. IASUMMETP (SQL DDL) - PF1: Library Summary Sizing Metrics              */
/* 3. IADTLMETP (SQL DDL) - PF2: Member Detail Sizing Metrics                */
/* 4. EXTRPGRG  (SQLRPGLE)- Extraction & Line Sizing Engine                  */
/* 5. CHKLIBS   (CLLE)    - Validity Checking Program (VLDPGM)               */
/* 6. EXTRPGCL  (CLLE)    - Command Processing Controller Program (CPP)      */
/* 7. EXTRPGSRC (CMD)     - Custom Command with VLDPGM & PGM bindings        */
/* ========================================================================= */

             PGM        PARM(&BLDLIB_IN)

             DCL        VAR(&BLDLIB_IN) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BLDLIB)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGDTA)    TYPE(*CHAR) LEN(256)

             /* 1. Resolve Target Build Library */
             IF         COND(&BLDLIB_IN = '*CURLIB' *OR &BLDLIB_IN = ' ') THEN(DO)
                RTVJOBA    CURLIB(&BLDLIB)
                IF         COND(&BLDLIB = '*NONE') THEN(CHGVAR VAR(&BLDLIB) VALUE('QGPL'))
             ENDDO
             ELSE       CMD(CHGVAR VAR(&BLDLIB) VALUE(&BLDLIB_IN))

             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Building EXTRPGSRC utility into library ' *CAT +
                          &BLDLIB *TCAT '...') MSGTYPE(*INFO)

             /* Step 1: Create Consolidated Source Records Table (IASRCRECP) */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 1/7: IASRCRECP (Source DDL)...') +
                          MSGTYPE(*INFO)

             CHKOBJ     OBJ(&BLDLIB/IASRCRECP) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                RUNSQLSTM  SRCFILE(&BLDLIB/QSQLSRC) SRCMBR(IASRCRECP) +
                             COMMIT(*NONE) DFTRDBCOL(&BLDLIB)
                MONMSG     MSGID(CPF0000) EXEC(DO)
                   CHGVAR     VAR(&MSGDTA) VALUE('Failed to compile IASRCRECP.')
                   SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                                MSGTYPE(*ESCAPE)
                ENDDO
             ENDDO

             /* Step 2: Create PF1: Library Summary Metrics (IASUMMETP) */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 2/7: IASUMMETP (PF1 Summary DDL)...') +
                          MSGTYPE(*INFO)

             CHKOBJ     OBJ(&BLDLIB/IASUMMETP) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                RUNSQLSTM  SRCFILE(&BLDLIB/QSQLSRC) SRCMBR(IASUMMETP) +
                             COMMIT(*NONE) DFTRDBCOL(&BLDLIB)
                MONMSG     MSGID(CPF0000) EXEC(DO)
                   CHGVAR     VAR(&MSGDTA) VALUE('Failed to compile IASUMMETP.')
                   SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                                MSGTYPE(*ESCAPE)
                ENDDO
             ENDDO

             /* Step 3: Create PF2: Member Detail Metrics (IADTLMETP) */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 3/7: IADTLMETP (PF2 Detail DDL)...') +
                          MSGTYPE(*INFO)

             CHKOBJ     OBJ(&BLDLIB/IADTLMETP) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                RUNSQLSTM  SRCFILE(&BLDLIB/QSQLSRC) SRCMBR(IADTLMETP) +
                             COMMIT(*NONE) DFTRDBCOL(&BLDLIB)
                MONMSG     MSGID(CPF0000) EXEC(DO)
                   CHGVAR     VAR(&MSGDTA) VALUE('Failed to compile IADTLMETP.')
                   SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                                MSGTYPE(*ESCAPE)
                ENDDO
             ENDDO

             /* Step 4: Compile RPGLE Extraction & Metrics Engine (EXTRPGRG) */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 4/7: EXTRPGRG (SQLRPGLE)...') +
                          MSGTYPE(*INFO)

             CRTSQLRPGI OBJ(&BLDLIB/EXTRPGRG) SRCFILE(&BLDLIB/QRPGLESRC) +
                          SRCMBR(EXTRPGRG) COMMIT(*NONE) OBJTYPE(*PGM) +
                          REPLACE(*YES) DBGVIEW(*SOURCE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR     VAR(&MSGDTA) VALUE('Failed to compile EXTRPGRG.')
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                             MSGTYPE(*ESCAPE)
             ENDDO

             /* Step 5: Compile Validity Checking Program (CHKLIBS) */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 5/7: CHKLIBS (CLLE VLDPGM)...') +
                          MSGTYPE(*INFO)

             CRTBNDCL   PGM(&BLDLIB/CHKLIBS) SRCFILE(&BLDLIB/QCLLESRC) +
                          SRCMBR(CHKLIBS) REPLACE(*YES) DBGVIEW(*SOURCE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR     VAR(&MSGDTA) VALUE('Failed to compile CHKLIBS.')
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                             MSGTYPE(*ESCAPE)
             ENDDO

             /* Step 6: Compile Controller Program (EXTRPGCL) */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 6/7: EXTRPGCL (CLLE CPP)...') +
                          MSGTYPE(*INFO)

             CRTBNDCL   PGM(&BLDLIB/EXTRPGCL) SRCFILE(&BLDLIB/QCLLESRC) +
                          SRCMBR(EXTRPGCL) REPLACE(*YES) DBGVIEW(*SOURCE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR     VAR(&MSGDTA) VALUE('Failed to compile EXTRPGCL.')
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                             MSGTYPE(*ESCAPE)
             ENDDO

             /* Step 7: Create Custom Command (EXTRPGSRC) */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 7/7: EXTRPGSRC (CMD with VLDPGM)...') +
                          MSGTYPE(*INFO)

             CRTCMD     CMD(&BLDLIB/EXTRPGSRC) PGM(&BLDLIB/EXTRPGCL) +
                          SRCFILE(&BLDLIB/QCMDSRC) SRCMBR(EXTRPGSRC) +
                          VLDPGM(&BLDLIB/CHKLIBS) REPLACE(*YES) +
                          TEXT('Extract RPG Source & Metrics to Consolidated PFs')
             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR     VAR(&MSGDTA) VALUE('Failed to create command EXTRPGSRC.')
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                             MSGTYPE(*ESCAPE)
             ENDDO

             /* Build Completed Successfully */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('BUILD SUCCESSFUL: All 7 objects created in ' +
                          *CAT &BLDLIB *TCAT '.') MSGTYPE(*COMP)

             RETURN
             ENDPGM
