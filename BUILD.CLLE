/* ========================================================================= */
/* Program Name : BUILD                                                      */
/* Description  : Build & Compilation Script for RPG Source Extraction Tool  */
/* Language     : ILE CL (CLLE)                                              */
/* Author       : IBM i Extraction Utility Team                              */
/*                                                                           */
/* Compilation Sequence:                                                     */
/* 1. EXTRPGPF  (PF)      - Output Consolidated Physical File                */
/* 2. EXTRPGRG  (SQLRPGLE)- Source Extraction & Dynamic SQL Engine           */
/* 3. CHKLIBS   (CLLE)    - Pre-Execution Validity Checking Program (VLDPGM) */
/* 4. EXTRPGCL  (CLLE)    - Command Processing Controller Program (CPP)      */
/* 5. EXTRPGSRC (CMD)     - Custom Command with VLDPGM & PGM bindings        */
/* ========================================================================= */

             PGM        PARM(&BLDLIB_IN)

             DCL        VAR(&BLDLIB_IN) TYPE(*CHAR) LEN(10)
             DCL        VAR(&BLDLIB)    TYPE(*CHAR) LEN(10)
             DCL        VAR(&MSGDTA)    TYPE(*CHAR) LEN(256)

             /* ----------------------------------------------------------- */
             /* 1. Resolve Target Build Library                             */
             /* ----------------------------------------------------------- */
             IF         COND(&BLDLIB_IN = '*CURLIB' *OR &BLDLIB_IN = ' ') THEN(DO)
                RTVJOBA    CURLIB(&BLDLIB)
                IF         COND(&BLDLIB = '*NONE') THEN(CHGVAR VAR(&BLDLIB) VALUE('QGPL'))
             ENDDO
             ELSE       CMD(CHGVAR VAR(&BLDLIB) VALUE(&BLDLIB_IN))

             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Building EXTRPGSRC utility into library ' *CAT +
                          &BLDLIB *TCAT '...') MSGTYPE(*INFO)

             /* ----------------------------------------------------------- */
             /* Step 1: Create Output Physical File (EXTRPGPF)              */
             /* ----------------------------------------------------------- */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 1/5: EXTRPGPF (PF)...') MSGTYPE(*INFO)

             CHKOBJ     OBJ(&BLDLIB/EXTRPGPF) OBJTYPE(*FILE)
             MONMSG     MSGID(CPF9801) EXEC(DO)
                CRTPF      FILE(&BLDLIB/EXTRPGPF) SRCFILE(&BLDLIB/QDDSSRC) +
                             SRCMBR(EXTRPGPF) +
                             TEXT('Consolidated RPG Source Records Repository')
                MONMSG     MSGID(CPF0000) EXEC(DO)
                   CHGVAR     VAR(&MSGDTA) VALUE('Failed to compile EXTRPGPF.')
                   SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                                MSGTYPE(*ESCAPE)
                ENDDO
             ENDDO

             /* ----------------------------------------------------------- */
             /* Step 2: Compile RPGLE Extraction Engine (EXTRPGRG)          */
             /* ----------------------------------------------------------- */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 2/5: EXTRPGRG (SQLRPGLE)...') +
                          MSGTYPE(*INFO)

             CRTSQLRPGI OBJ(&BLDLIB/EXTRPGRG) SRCFILE(&BLDLIB/QRPGLESRC) +
                          SRCMBR(EXTRPGRG) COMMIT(*NONE) OBJTYPE(*PGM) +
                          REPLACE(*YES) DBGVIEW(*SOURCE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR     VAR(&MSGDTA) VALUE('Failed to compile EXTRPGRG.')
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                             MSGTYPE(*ESCAPE)
             ENDDO

             /* ----------------------------------------------------------- */
             /* Step 3: Compile Validity Checking Program (CHKLIBS)         */
             /* ----------------------------------------------------------- */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 3/5: CHKLIBS (CLLE VLDPGM)...') +
                          MSGTYPE(*INFO)

             CRTBNDCL   PGM(&BLDLIB/CHKLIBS) SRCFILE(&BLDLIB/QCLLESRC) +
                          SRCMBR(CHKLIBS) REPLACE(*YES) DBGVIEW(*SOURCE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR     VAR(&MSGDTA) VALUE('Failed to compile CHKLIBS.')
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                             MSGTYPE(*ESCAPE)
             ENDDO

             /* ----------------------------------------------------------- */
             /* Step 4: Compile Controller Program (EXTRPGCL)               */
             /* ----------------------------------------------------------- */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 4/5: EXTRPGCL (CLLE CPP)...') +
                          MSGTYPE(*INFO)

             CRTBNDCL   PGM(&BLDLIB/EXTRPGCL) SRCFILE(&BLDLIB/QCLLESRC) +
                          SRCMBR(EXTRPGCL) REPLACE(*YES) DBGVIEW(*SOURCE)
             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR     VAR(&MSGDTA) VALUE('Failed to compile EXTRPGCL.')
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                             MSGTYPE(*ESCAPE)
             ENDDO

             /* ----------------------------------------------------------- */
             /* Step 5: Create Custom Command (EXTRPGSRC)                   */
             /* ----------------------------------------------------------- */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('Compiling Step 5/5: EXTRPGSRC (CMD with VLDPGM)...') +
                          MSGTYPE(*INFO)

             CRTCMD     CMD(&BLDLIB/EXTRPGSRC) PGM(&BLDLIB/EXTRPGCL) +
                          SRCFILE(&BLDLIB/QCMDSRC) SRCMBR(EXTRPGSRC) +
                          VLDPGM(&BLDLIB/CHKLIBS) REPLACE(*YES) +
                          TEXT('Extract RPG Source to Consolidated PF')
             MONMSG     MSGID(CPF0000) EXEC(DO)
                CHGVAR     VAR(&MSGDTA) VALUE('Failed to create command EXTRPGSRC.')
                SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                             MSGTYPE(*ESCAPE)
             ENDDO

             /* ----------------------------------------------------------- */
             /* Build Completed Successfully                                */
             /* ----------------------------------------------------------- */
             SNDPGMMSG  MSGID(CPF9898) MSGF(QCPFMSG) +
                          MSGDTA('BUILD SUCCESSFUL: All EXTRPGSRC objects created in ' +
                          *CAT &BLDLIB *TCAT '.') MSGTYPE(*COMP)

             RETURN
             ENDPGM
