/* ========================================================================= */
/* Program Name : CHKLIBS                                                    */
/* Description  : Validity Checking Program (VLDPGM) for EXTRPGSRC Command   */
/* Language     : ILE CL (CLLE)                                              */
/* Author       : IBM i Extraction Utility Team                              */
/*                                                                           */
/* Purpose:                                                                  */
/* Validates that all entered libraries exist and are accessible before the  */
/* Command Processing Program (EXTRPGCL) is invoked.                         */
/*                                                                           */
/* Signaling:                                                                */
/* Sends CPD0006 (*DIAG) for each invalid library and raises CPF0002         */
/* (*ESCAPE) to instruct the OS/400 Command Analyzer to halt execution.       */
/* ========================================================================= */

             PGM        PARM(&LIBLIST &OUTLIB &OUTFILE &CLEAR)

             /* ----------------------------------------------------------- */
             /* Parameter Declarations                                       */
             /* ----------------------------------------------------------- */
             DCL        VAR(&LIBLIST)  TYPE(*CHAR) LEN(102)
             DCL        VAR(&OUTLIB)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&OUTFILE)  TYPE(*CHAR) LEN(10)
             DCL        VAR(&CLEAR)    TYPE(*CHAR) LEN(4)

             /* ----------------------------------------------------------- */
             /* Work Variables                                               */
             /* ----------------------------------------------------------- */
             /* &LIB_CNT maps to the first 2 bytes of &LIBLIST (element count)*/
             DCL        VAR(&LIB_CNT)  TYPE(*INT)  LEN(2) STG(*DEFINED) +
                          DEFVAR(&LIBLIST 1)
             DCL        VAR(&IDX)      TYPE(*INT)  LEN(4)
             DCL        VAR(&OFFSET)   TYPE(*INT)  LEN(4)
             DCL        VAR(&CURLIB)   TYPE(*CHAR) LEN(10)
             DCL        VAR(&HASERROR) TYPE(*LGL)  VALUE('0')
             DCL        VAR(&MSGDTA)   TYPE(*CHAR) LEN(256)

             /* ----------------------------------------------------------- */
             /* 1. Validate Input Libraries (1 to 10 entries)               */
             /* ----------------------------------------------------------- */
             DOFOR      VAR(&IDX) FROM(1) TO(&LIB_CNT)
                /* Calculate starting position for current 10-char library */
                CHGVAR     VAR(&OFFSET) VALUE(3 + ((&IDX - 1) * 10))
                CHGVAR     VAR(&CURLIB) VALUE(%SST(&LIBLIST &OFFSET 10))

                /* Verify library exists */
                CHKOBJ     OBJ(&CURLIB) OBJTYPE(*LIB)
                MONMSG     MSGID(CPF9801) EXEC(DO)
                   /* CPD0006 requires 4-byte padding ('0000') + message text */
                   CHGVAR     VAR(&MSGDTA) VALUE('0000Library ' *CAT +
                                &CURLIB *TCAT ' does not exist.')
                   SNDPGMMSG  MSGID(CPD0006) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                                MSGTYPE(*DIAG)
                   CHGVAR     VAR(&HASERROR) VALUE('1')
                ENDDO

                MONMSG     MSGID(CPF9802) EXEC(DO)
                   CHGVAR     VAR(&MSGDTA) VALUE('0000Not authorized to library ' +
                                *CAT &CURLIB *TCAT '.')
                   SNDPGMMSG  MSGID(CPD0006) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                                MSGTYPE(*DIAG)
                   CHGVAR     VAR(&HASERROR) VALUE('1')
                ENDDO
             ENDDO

             /* ----------------------------------------------------------- */
             /* 2. Validate Output Library (if specified and not *CURLIB)   */
             /* ----------------------------------------------------------- */
             IF         COND(&OUTLIB *NE '*CURLIB' *AND &OUTLIB *NE ' ') THEN(DO)
                CHKOBJ     OBJ(&OUTLIB) OBJTYPE(*LIB)
                MONMSG     MSGID(CPF9801) EXEC(DO)
                   CHGVAR     VAR(&MSGDTA) VALUE('0000Output library ' *CAT +
                                &OUTLIB *TCAT ' does not exist.')
                   SNDPGMMSG  MSGID(CPD0006) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                                MSGTYPE(*DIAG)
                   CHGVAR     VAR(&HASERROR) VALUE('1')
                ENDDO

                MONMSG     MSGID(CPF9802) EXEC(DO)
                   CHGVAR     VAR(&MSGDTA) VALUE('0000Not authorized to output library ' +
                                *CAT &OUTLIB *TCAT '.')
                   SNDPGMMSG  MSGID(CPD0006) MSGF(QCPFMSG) MSGDTA(&MSGDTA) +
                                MSGTYPE(*DIAG)
                   CHGVAR     VAR(&HASERROR) VALUE('1')
                ENDDO
             ENDDO

             /* ----------------------------------------------------------- */
             /* 3. Signal Validation Status to Command Analyzer             */
             /* ----------------------------------------------------------- */
             IF         COND(&HASERROR) THEN(DO)
                /* CPF0002 tells OS/400 Command Analyzer that validation failed*/
                SNDPGMMSG  MSGID(CPF0002) MSGF(QCPFMSG) MSGTYPE(*ESCAPE)
             ENDDO

             RETURN
             ENDPGM
